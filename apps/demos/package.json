{
	"name": "@svar-ui/svelte-calendar-demos",
	"version": "2.6.0",
	"private": true,
	"homepage": "https://svar.dev/svelte/calendar/",
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/calendar.git"
	},
	"files": [
		"dist",
		"readme.md",
		"license.txt"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build": "vp build",
		"lint": "vp lint ./demos ./src",
		"start": "vp dev --open",
		"watch": "svelte-package -i ./src --watch"
	},
	"dependencies": {
		"@svar-ui/calendar-locales": "workspace:*",
		"@svar-ui/core-locales": "catalog:",
		"@svar-ui/svelte-calendar": "workspace:*",
		"@svar-ui/svelte-comments": "catalog:",
		"@svar-ui/svelte-core": "catalog:",
		"@svar-ui/svelte-editor": "catalog:",
		"@svar-ui/svelte-filter": "catalog:",
		"@svar-ui/svelte-layout": "catalog:",
		"@svar-ui/svelte-tasklist": "catalog:",
		"@svar-ui/svelte-toolbar": "catalog:",
		"svelte-spa-router": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:"
	}
}
